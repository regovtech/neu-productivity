# Copy to apps/web/.env.local and fill in real values
# For Vercel, set these in the Vercel dashboard (Project → Settings → Environment Variables)

# PostgreSQL connection string — copy from Railway dashboard after provisioning Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/neu_dev

# NextAuth.js v5
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Full public URL of the app (no trailing slash)
# Vercel staging: https://<your-project>.vercel.app
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
# Add your Vercel deploy URL to "Authorized redirect URIs":
#   https://<your-project>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com) — transactional email
RESEND_API_KEY=

# Cron job shared secret (used by /api/cron/* routes to verify caller identity)
# generate with: openssl rand -base64 16
CRON_SECRET=

# Sentry error monitoring (https://sentry.io → Project → Settings → SDK Setup)
# Server-side DSN (keep secret — never expose in NEXT_PUBLIC_*)
SENTRY_DSN=
# Client-side DSN (can be public — used in browser SDK)
NEXT_PUBLIC_SENTRY_DSN=
# For source map uploads during production builds (optional but recommended):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
